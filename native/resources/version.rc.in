#include <windows.h>
#include "resource.h"

IDI_DESKTOPTODOLIST ICON "@DESKTOP_TODO_ICON_RESOURCE_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @DESKTOP_TODO_FILE_VERSION@
 PRODUCTVERSION @DESKTOP_TODO_FILE_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName", "DesktopTodoList Project\0"
      VALUE "FileDescription", "Native floating desktop task list\0"
      VALUE "FileVersion", "@DESKTOP_TODO_FILE_VERSION_DOTTED@\0"
      VALUE "InternalName", "DesktopTodoList\0"
      VALUE "OriginalFilename", "DesktopTodoList.exe\0"
      VALUE "ProductName", "DesktopTodoList\0"
      VALUE "ProductVersion", "@DESKTOP_TODO_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
